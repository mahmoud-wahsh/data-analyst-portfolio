rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Portfolio images and assets: public read access
    // File uploads and modifications: restricted to authenticated users
    match /portfolio/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default fallback rule
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
